NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Host-mapped port is 5433, not 5432, to avoid clashing with a locally installed Postgres.
DATABASE_URL=postgresql://ag2:ag2_dev_password@localhost:5433/ag2?schema=public

REDIS_URL=redis://localhost:6379
BUILD_WORKER_CONCURRENCY=2

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-32-plus-char-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_SECRET=replace-with-32-plus-char-secret
JWT_REFRESH_TTL_DAYS=30
COOKIE_SECRET=replace-with-32-plus-char-secret

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this makes every previously-encrypted signing keystore
# undecryptable — back it up (a real secrets manager in production) and
# never regenerate it casually.
SIGNING_KEY_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=ag2_minio_admin
S3_SECRET_ACCESS_KEY=ag2_minio_admin_secret
S3_BUCKET=ag2-dev
S3_FORCE_PATH_STYLE=true

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@ag2.dev

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=ag2-api
SENTRY_DSN=

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
# Leave unset (defaults to 5/10) in production. Raise only for local dev/e2e,
# where legitimately registering or logging in many test accounts in a short
# window would otherwise trip a limit tuned for real abusive traffic.
AUTH_REGISTER_THROTTLE_LIMIT=5
AUTH_LOGIN_THROTTLE_LIMIT=10

LOG_LEVEL=debug
